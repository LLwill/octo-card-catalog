{
  "schemaVersion": 2,
  "id": "docs.access-request",
  "name": "文档访问申请",
  "version": "0.2.0",
  "contractVersion": "1.0.0",
  "adaptiveCardVersion": "1.5",
  "renderProfile": "octo-chat@latest",
  "defaultLocale": "zh-CN",
  "dataSchema": "contract/data.schema.json",
  "views": {
    "pending": {
      "wireProfile": "octo/v2",
      "template": "templates/pending.template.json",
      "samples": ["samples/pending.json"]
    },
    "result": {
      "wireProfile": "octo/v1",
      "template": "templates/result.template.json",
      "samples": ["samples/approved.json", "samples/rejected.json"]
    }
  }
}
