{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "accent",
      "bleed": true,
      "spacing": "None",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${kicker}",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "wrap": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${replyTargetLabel}",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "wrap": true,
                  "horizontalAlignment": "Right"
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${title}",
          "size": "Medium",
          "weight": "Bolder",
          "wrap": true,
          "spacing": "Small"
        },
        {
          "type": "TextBlock",
          "text": "${description}",
          "isSubtle": true,
          "wrap": true,
          "spacing": "None"
        }
      ]
    },
    {
      "type": "Input.ChoiceSet",
      "id": "decision_choice",
      "style": "expanded",
      "isMultiSelect": "${isMultiSelect}",
      "isRequired": true,
      "errorMessage": "请至少选择一个方向",
      "value": "${defaultValue}",
      "spacing": "Medium",
      "wrap": true,
      "choices": [
        {
          "$data": "${options}",
          "title": "${label}",
          "value": "${value}"
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "${previewHint}",
          "size": "Small",
          "wrap": true,
          "spacing": "None"
        },
        {
          "type": "TextBlock",
          "text": "${previewPlaceholder}",
          "size": "Small",
          "isSubtle": true,
          "wrap": true,
          "spacing": "Small"
        }
      ]
    },
    {
      "type": "Input.Text",
      "id": "decision_note",
      "isMultiline": false,
      "isRequired": false,
      "maxLength": 500,
      "placeholder": "${notePlaceholder}",
      "spacing": "Medium"
    },
    {
      "type": "Container",
      "style": "default",
      "bleed": true,
      "spacing": "Large",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": " ",
                  "spacing": "None"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "ActionSet",
                  "spacing": "None",
                  "horizontalAlignment": "Right",
                  "actions": [
                    {
                      "type": "Action.Submit",
                      "id": "decision_send",
                      "title": "${sendActionTitle}",
                      "style": "positive",
                      "data": {
                        "action": "decision_send",
                        "decisionId": "${decisionId}",
                        "mode": "choose",
                        "replyTargetName": "${replyTargetName}"
                      }
                    }
                  ]
                },
                {
                  "type": "TextBlock",
                  "text": "${footerHint}",
                  "size": "Small",
                  "isSubtle": true,
                  "wrap": true,
                  "spacing": "Small",
                  "horizontalAlignment": "Right"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
