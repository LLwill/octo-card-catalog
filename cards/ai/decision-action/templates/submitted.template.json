{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "accent",
      "bleed": true,
      "spacing": "None",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${kicker}",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "wrap": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${statusLabel}",
                  "size": "Small",
                  "weight": "Bolder",
                  "color": "Good",
                  "spacing": "None",
                  "wrap": true,
                  "horizontalAlignment": "Right"
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${title}",
          "size": "Medium",
          "weight": "Bolder",
          "wrap": true,
          "spacing": "Small"
        },
        {
          "type": "TextBlock",
          "text": "${description}",
          "isSubtle": true,
          "wrap": true,
          "spacing": "None"
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "已发送内容",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None"
        },
        {
          "type": "TextBlock",
          "text": "${submittedSummary}",
          "wrap": true,
          "spacing": "Small"
        },
        {
          "type": "TextBlock",
          "text": "回复对象：@${replyTargetName}",
          "size": "Small",
          "isSubtle": true,
          "wrap": true,
          "spacing": "Small"
        }
      ]
    }
  ]
}
