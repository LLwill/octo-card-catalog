{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "accent",
      "bleed": true,
      "spacing": "None",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "需要你选择",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "wrap": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "回复 @Octo 智能助手",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "wrap": true,
                  "horizontalAlignment": "Right"
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "下一步从哪个方向继续？",
          "size": "Medium",
          "weight": "Bolder",
          "wrap": true,
          "spacing": "Small"
        },
        {
          "type": "TextBlock",
          "text": "选择只会生成一条新的用户消息，不会在这张卡内直接执行。",
          "isSubtle": true,
          "wrap": true,
          "spacing": "None"
        }
      ]
    },
    {
      "type": "Input.ChoiceSet",
      "id": "decision_choice",
      "style": "expanded",
      "isMultiSelect": false,
      "isRequired": true,
      "errorMessage": "请至少选择一个方向",
      "value": "",
      "spacing": "Medium",
      "wrap": true,
      "choices": [
        {
          "title": "补全消息交互（推荐）\n明确卡片、独立用户消息与后续 AI 回复的边界。",
          "value": "interaction"
        },
        {
          "title": "完善移动端布局\n检查窄屏卡片、长按钮与建议输入区的排列。",
          "value": "mobile"
        },
        {
          "title": "输出开发规格\n整理组件结构、提及字段与消息关联契约。",
          "value": "handoff"
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "将作为新消息发送给 @Octo 智能助手",
          "size": "Small",
          "wrap": true,
          "spacing": "None"
        },
        {
          "type": "TextBlock",
          "text": "请选择至少一个方向。",
          "size": "Small",
          "isSubtle": true,
          "wrap": true,
          "spacing": "Small"
        }
      ]
    },
    {
      "type": "Input.Text",
      "id": "decision_note",
      "isMultiline": false,
      "isRequired": false,
      "maxLength": 500,
      "placeholder": "可选补充说明（将一并作为新消息发出）",
      "spacing": "Medium"
    },
    {
      "type": "Container",
      "style": "default",
      "bleed": true,
      "spacing": "Large",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": " ",
                  "spacing": "None"
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "ActionSet",
                  "spacing": "None",
                  "horizontalAlignment": "Right",
                  "actions": [
                    {
                      "type": "Action.Submit",
                      "id": "decision_send",
                      "title": "发送选择",
                      "style": "positive",
                      "data": {
                        "action": "decision_send",
                        "decisionId": "decision-next-step-001",
                        "mode": "choose",
                        "replyTargetName": "Octo 智能助手"
                      }
                    }
                  ]
                },
                {
                  "type": "TextBlock",
                  "text": "发送后将新增一条独立用户消息 · @Octo 智能助手",
                  "size": "Small",
                  "isSubtle": true,
                  "wrap": true,
                  "spacing": "Small",
                  "horizontalAlignment": "Right"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
