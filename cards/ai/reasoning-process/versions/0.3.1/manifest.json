{
  "schemaVersion": 2,
  "id": "ai.reasoning-process",
  "name": "推理过程卡",
  "version": "0.3.1",
  "contractVersion": "1.2.0",
  "adaptiveCardVersion": "1.5",
  "renderProfile": "octo-chat@1.2.0-rc.4",
  "renderProfileCompatibility": "octo-chat/v1",
  "defaultLocale": "zh-CN",
  "dataSchema": "contract/data.schema.json",
  "views": {
    "active": {
      "wireProfile": "octo/v2",
      "states": ["reasoning", "answering"],
      "submit_actions": [],
      "template": "templates/active.template.json",
      "samples": [
        "samples/reasoning.json",
        "samples/answering.json"
      ]
    },
    "result": {
      "wireProfile": "octo/v1",
      "states": ["completed", "stopped"],
      "submit_actions": [],
      "template": "templates/result.template.json",
      "samples": [
        "samples/completed.json",
        "samples/stopped.json"
      ]
    },
    "error": {
      "wireProfile": "octo/v2",
      "states": ["error"],
      "submit_actions": [],
      "template": "templates/error.template.json",
      "samples": [
        "samples/error.json"
      ]
    }
  }
}
